{
  "name": "tickr-server",
  "version": "0.0.0",
  "main": "src/index.ts",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/adapter-libsql": "^7.3.0",
    "@prisma/client": "7.3.0",
    "@sinclair/typebox": "^0.34.48",
    "fast-jwt": "^6.1.0",
    "fastify": "^5.7.4",
    "fastify-graceful-shutdown": "^5.0.0",
    "fastify-plugin": "^5.1.0",
    "pino": "^10.3.1",
    "prisma": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/bun": "^1.3.9",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target=bun --production",
    "dev": "bun --hot ./src/index.ts | pino-pretty",
    "db:fetch_coins": "bun ./src/jobs/fetch_coins.ts",
    "db:migrate": "prisma db push && prisma generate",
    "format": "prettier src/ --write",
    "lint": "eslint . --fix",
    "prepare": "husky",
    "start": "bun ./src/index.ts"
  },
  "type": "module"
}
